CREATE TABLE IF NOT EXISTS product (
  id UUID PRIMARY KEY NOT NULL,
  name TEXT NOT NULL,
  price NUMERIC(10, 2) NOT NULL,
  weight DECIMAL,
  in_stock BOOLEAN NOT NULL,
  image BYTEA,
  added_at DATE,
  restock_time TIME,
  updated_at TIMESTAMP,
  created_at TIMESTAMPTZ NOT NULL
);

insert:
INSERT INTO product(id, name, price, weight, in_stock, image, added_at, restock_time, updated_at, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllProducts:
SELECT * FROM product;

getLastCreatedAt:
SELECT MAX(created_at) FROM product;

getMaxPrice:
SELECT MAX(price) FROM product;

countProducts:
SELECT COUNT(*) FROM product;
